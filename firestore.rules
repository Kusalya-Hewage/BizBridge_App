rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ["admin@bizbridge.com", "alex@bizbridge.example"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN")
      );
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    // ─── Users Collection ──────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    // ─── Businesses Collection ─────────────────────────────────────
    match /businesses/{businessId} {
      allow read, write: if true;

      // Subcollection: Services
      match /services/{serviceId} {
        allow read, write: if true;
      }
    }

    // ─── Business Applications ─────────────────────────────────────
    match /businessApplications/{applicationId} {
      allow read, write: if true;
    }

    // ─── Qualification Documents ───────────────────────────────────
    match /qualificationVerifications/{documentId} {
      allow read, write: if true;
    }

    // ─── Bookings Collection ───────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.businessOwnerId == request.auth.uid ||
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.customerId == request.auth.uid && request.resource.data.status == 'CANCELLED') ||
        resource.data.businessOwnerId == request.auth.uid ||
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── Slot Reservations (Double-booking prevention) ──────────────
    match /reservations/{slotKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── Reviews Collection ────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Promotions Collection ─────────────────────────────────────
    match /promotions/{promotionId} {
      allow read, write: if true;
    }

    // ─── Notifications Collection ──────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // ─── Moderation Reports Collection ─────────────────────────────
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // ─── Platform Announcements ────────────────────────────────────
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // ─── Admin Audit Logs ──────────────────────────────────────────
    match /adminAuditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
