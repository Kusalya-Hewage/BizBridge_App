<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Top Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_admin_demo_pill">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:letterSpacing="0.08"
                    android:text="ADMIN CONSOLE · ANNOUNCEMENTS"
                    android:textColor="@color/admin_badge_demo_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Screen Header Row with Back Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_chip_default"
                        android:contentDescription="Back"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/admin_text_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="Announcements"
                        android:textColor="@color/admin_text_title"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_notifications"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip_default"
                    android:contentDescription="Notifications"
                    android:padding="8dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/admin_text_title" />
            </RelativeLayout>

            <!-- Compose Announcement Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/inter_variable"
                android:text="Compose announcement"
                android:textColor="@color/admin_text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Title Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_variable"
                android:text="Title"
                android:textColor="@color/admin_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_announce_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/inter_variable"
                android:hint="A little update for our local community"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="A little update for our local community"
                android:textColor="@color/admin_text_title"
                android:textSize="13sp" />

            <!-- Message Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_variable"
                android:text="Message"
                android:textColor="@color/admin_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_announce_message"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/inter_variable"
                android:gravity="top|start"
                android:hint="Compose your update message..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:text="Keep your business hours current so customers can book with confidence. Review your schedule before the holiday season."
                android:textColor="@color/admin_text_title"
                android:textSize="13sp" />

            <!-- Target Audience -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/inter_variable"
                android:text="Target audience"
                android:textColor="@color/admin_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pill_aud_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_admin_tab_inactive"
                    android:fontFamily="@font/inter_variable"
                    android:text="All users"
                    android:textColor="@color/admin_text_body"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pill_aud_customers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_admin_tab_inactive"
                    android:fontFamily="@font/inter_variable"
                    android:text="Customers"
                    android:textColor="@color/admin_text_body"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pill_aud_owners"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_admin_tab_active"
                    android:fontFamily="@font/inter_variable"
                    android:text="Owners"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preview Notice Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_admin_banner_info"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/admin_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_variable"
                    android:text="Static compose preview. Publishing does not deliver notifications or messages."
                    android:textColor="@color/admin_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Publish / Send Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_publish_announcement"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_admin_button_primary"
                android:fontFamily="@font/inter_variable"
                android:text="Publish / Send Announcement"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Recent announcements section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/inter_variable"
                android:text="Recent announcements"
                android:textColor="@color/admin_text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Recent Item 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_admin_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/inter_variable"
                        android:text="Welcome to BizBridge"
                        android:textColor="@color/admin_text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_admin_badge_active"
                        android:fontFamily="@font/inter_variable"
                        android:text="Published"
                        android:textColor="@color/admin_badge_active_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="All users · Created Oct 18, 2026"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="Demo delivery status: Sent · 1,120 recipients"
                    android:textColor="@color/admin_text_body"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Recent Item 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_admin_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/inter_variable"
                        android:text="Update your opening hours"
                        android:textColor="@color/admin_text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_admin_badge_scheduled"
                        android:fontFamily="@font/inter_variable"
                        android:text="Scheduled"
                        android:textColor="@color/admin_badge_scheduled_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="Business owners · Oct 25, 9:00 AM"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
