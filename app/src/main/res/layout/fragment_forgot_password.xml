<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingStart="@dimen/screen_inset_horizontal"
    android:paddingTop="@dimen/screen_inset_top"
    android:paddingEnd="@dimen/screen_inset_horizontal"
    android:paddingBottom="@dimen/screen_inset_bottom">

    <!-- Top Subheader Tag -->
    <TextView
        android:id="@+id/tv_auth_tag"
        style="@style/TextAppearance.BizBridge.SubheaderTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/shared_auth_demo_tag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar with Back Arrow and Title -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_auth_tag">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/TextAppearance.BizBridge.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/forgot_password_title"
            android:textSize="21sp" />
    </LinearLayout>

    <!-- State 1: Request Reset Form Container -->
    <ScrollView
        android:id="@+id/sv_request_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card: Let's get you back in. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_lavender"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Mail"
                    android:src="@drawable/ic_mail" />

                <TextView
                    style="@style/TextAppearance.BizBridge.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/forgot_card_title" />

                <TextView
                    style="@style/TextAppearance.BizBridge.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/forgot_card_subtitle"
                    android:textSize="@dimen/text_body_small" />
            </LinearLayout>

            <!-- Email Input Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/TextAppearance.BizBridge.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_email" />

                <EditText
                    android:id="@+id/et_reset_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@null"
                    android:fontFamily="@font/inter_variable"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:text="@string/default_email"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </LinearLayout>

            <!-- Send Reset Link Button -->

            <!-- Back to Log In Link -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_send_reset"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_primary_action"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/inter_variable"
                android:text="@string/btn_send_reset_link"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_back_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/inter_variable"
                android:padding="8dp"
                android:text="@string/back_to_login"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Footer Security Note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_variable"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/forgot_footer"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>
    </ScrollView>

    <!-- State 2: Reset Instructions Requested (Supporting State "Check your inbox") -->
    <LinearLayout
        android:id="@+id/ll_success_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"
        tools:visibility="visible">

        <!-- Card: Reset instructions requested -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_lavender"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Mail Sent"
                android:src="@drawable/ic_mail" />

            <TextView
                style="@style/TextAppearance.BizBridge.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/reset_requested_title" />

            <TextView
                android:id="@+id/tv_success_desc"
                style="@style/TextAppearance.BizBridge.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="If an account exists for maya.chen@example.com, you\'ll receive a reset link shortly."
                android:textSize="@dimen/text_body_small" />
        </LinearLayout>

        <!-- Back to Log In Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_success_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_primary_action"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="@font/inter_variable"
            android:text="@string/back_to_login"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold" />

        <!-- Resend Link Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_resend"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_primary_action"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/inter_variable"
            android:text="@string/btn_resend_link"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_button"
            android:textStyle="bold" />

        <!-- Demo success note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/inter_variable"
            android:gravity="center"
            android:text="@string/demo_success_note"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
