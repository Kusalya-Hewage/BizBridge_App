rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read for images and documents, authenticated write with 20MB limit
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
